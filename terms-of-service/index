<style>
  :root {
    --bg: #f5f6f8;
    --card: #ffffff;
    --text: #1f2329;
    --muted: #646a73;
    --border: #e5e6eb;
    --accent: #1667f0;
    --accent-soft: #eef4ff;
    --code-bg: #f7f8fa;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.75;
    font-size: 16px;
  }
  .page { max-width: 860px; margin: 0 auto; padding: 0 20px 60px; }
  header.top {
    background: linear-gradient(135deg, #1667f0 0%, #4f8bff 100%);
    color: #fff;
    padding: 40px 0 34px;
    margin-bottom: 32px;
  }
  header.top .inner { max-width: 860px; margin: 0 auto; padding: 0 20px; }
  header.top h1 { margin: 0 0 8px; font-size: 26px; font-weight: 600; letter-spacing: .5px; }
  header.top .meta { font-size: 14px; opacity: .92; }
  header.top .meta span { margin-right: 18px; display: inline-block; }

  .notice {
    background: var(--accent-soft);
    border: 1px solid #cfdffd;
    border-left: 4px solid var(--accent);
    border-radius: 8px;
    padding: 16px 18px;
    margin: 0 0 28px;
    color: var(--text);
  }
  .notice strong { color: var(--accent); }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px 26px 14px;
    margin-bottom: 22px;
    box-shadow: 0 1px 2px rgba(0,0,0,.03);
  }
  h2 {
    font-size: 18px;
    margin: 22px 0 12px;
    padding-top: 18px;
    border-top: 1px dashed var(--border);
  }
  .card h2:first-child { border-top: none; padding-top: 0; margin-top: 14px; }
  p { margin: 10px 0; }
  ol, ul { margin: 10px 0; padding-left: 22px; }
  li { margin: 6px 0; }
  strong { font-weight: 600; }
  .small { font-size: 13px; color: var(--muted); }
  .contact {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 26px;
    box-shadow: 0 1px 2px rgba(0,0,0,.03);
  }
  .contact h2 { border: none; margin: 0 0 6px; padding: 0; font-size: 18px; }
  footer {
    max-width: 860px; margin: 8px auto 0; padding: 18px 20px 50px;
    color: var(--muted); font-size: 13px; text-align: center;
  }
  footer a { color: var(--accent); text-decoration: none; }
</style>
